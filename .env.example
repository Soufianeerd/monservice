# =============================================================================
# Configuration monservice
# Copier en .env.local et renseigner. Aucune de ces valeurs ne doit être
# versionnée. Les variables sont validées au démarrage (src/lib/env.ts) :
# une variable manquante fait échouer le boot plutôt que de dégrader en
# silence (anomalie MS-009).
# =============================================================================

# Runtime: restricted monservice_runtime pooled login, never migration owner.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Separate restricted worker logins, required only when enabled.
NEON_STRIPE_DATABASE_URL=
NEON_REMINDERS_DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3039
# Migration/admin URL belongs only in the ignored NEON_ADMIN_ENV_FILE.
# CI creates disposable synthetic branches from the empty ci-template.

# --- Stripe (optionnel) -------------------------------------------------------
# Absentes, l'application démarre et les routes de paiement renvoient 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Tâches planifiées (optionnel) -------------------------------------------
# Secret exigé en en-tête `x-cron-secret` par /api/reminders/check.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# --- E-mail -------------------------------------------------------------------
# Application emails use Resend. Auth emails are managed by Neon SMTP.
RESEND_API_KEY=
