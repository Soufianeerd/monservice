      alert(data.type === 'invoice' ? 'Facture créée avec succès !' : 'Devis créé avec succès !');\n      if (data.type === 'invoice') {\n        router.push(`/facturation/factures/${newInvoice.id}`);\n      } else {\n        router.push(`/facturation/devis/${newInvoice.id}`);\n      }\n      router.refresh();\n    } catch (error) {\n      handleError(error, \"Erreur lors de la création du document\");\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"p-8 max-w-7xl mx-auto space-y-6\">\n      <div>\n        <h1 className=\"text-3xl font-bold text-gray-900\">Nouveau Document</h1>\n        <p className=\"mt-1 text-sm text-gray-500\">\n          Créer un devis ou une facture.\n        </p>\n      </div>\n\n      <InvoiceForm \n        organizationId={user?.organizationId || ''}\n        onSubmit={handleSubmit} \n        isSubmitting={isSubmitting} \n      />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/soufianeelrhadi/Projets/monservice/src/app/(dashboard)/facturation/factures/page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Plus' is defined but never used.","line":5,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":14,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Plus"},"fix":{"range":[99,104],"text":""},"desc":"Remove unused variable \"Plus\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Edit' is defined but never used.","line":5,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Edit"},"fix":{"range":[103,109],"text":""},"desc":"Remove unused variable \"Edit\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Trash2' is defined but never used.","line":5,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":28,"sugges