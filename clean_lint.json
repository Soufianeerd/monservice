 shadow border border-gray-200\">\n      \n      <div>\n        <label className=\"block text-sm font-medium text-gray-700\">Nom du modèle *</label>\n        <input\n          type=\"text\"\n          {...register('name')}\n          className=\"text-gray-900 mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm\"\n        />\n        {errors.name && <p className=\"mt-1 text-sm text-red-600\">{errors.name.message}</p>}\n      </div>\n\n      <div>\n        <label className=\"block text-sm font-medium text-gray-700\">Type de message *</label>\n        <select\n          {...register('type')}\n          className=\"text-gray-900 mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md\"\n        >\n          <option value=\"email\">Email</option>\n          <option value=\"sms\">SMS</option>\n        </select>\n        {errors.type && <p className=\"mt-1 text-sm text-red-600\">{errors.type.message}</p>}\n      </div>\n\n      {type === 'email' && (\n        <div>\n          <label className=\"block text-sm font-medium text-gray-700\">Objet de l'email *</label>\n          <input\n            type=\"text\"\n            {...register('subject')}\n            className=\"text-gray-900 mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm\"\n          />\n          {errors.subject && <p className=\"mt-1 text-sm text-red-600\">{errors.subject.message}</p>}\n        </div>\n      )}\n\n      <div>\n        <label className=\"block text-sm font-medium text-gray-700\">Corps du message *</label>\n        <p className=\"text-xs text-gray-500 mb-2\">Variables disponibles : {'{{clientName}}, {{invoiceNumber}}, {{amount}}, {{dueDate}}'}</p>\n        <textarea\n          {...register('body')}\n          rows={8}\n          className=\"text-gray-900 mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm\"\n        />\n        {errors.body && <p className=\"mt-1 text-sm text-red-600\">{errors.body.message}</p>}\n      </div>\n\n      <div className=\"flex justify-end space-x-3 pt-4 border-t border-gray-200\">\n        <button\n          type=\"button\"\n          onClick={() => router.back()}\n          className=\"px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none\"\n        >\n          Annuler\n        </button>\n        <button\n          type=\"submit\"\n          disabled={isSubmitting}\n          className=\"px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none disabled:opacity-50\"\n        >\n          {isSubmitting ? 'Enregistrement...' : 'Enregistrer le modèle'}\n        </button>\n      </div>\n    </form>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/soufianeelrhadi/Projets/monservice/src/components/demo/ClientList.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'getByIdAction' is defined but never used.","line":4,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":23,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"getByIdAction"},"fix":{"range":[161,175],"text":""},"desc":"Remove unused variable \"getByIdAction\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'updateAction' is defined but never used.","line":4,"column":25,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":37,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"updateAction"},"fix":{"range":[152,234],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'organizationId'. Either include it or remove the dependency array.","line":50,"column":6,"nodeType":"ArrayExpression","endLine":50,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [organizationId]","fix":{"range":[1703,1705],"text":"[organizationId]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\nimport * as clientActions from '@/app/actions/client.actions';\nimport * as organizationActions from '@/app/actions/organization.actions';\nimport { getByIdAction, updateAction } from '@/app/actions/organization.actions';\n\nimport { useState, useEffect } from 'react';\nimport { Client, Organization } from '@/lib/data/interfaces';\n\ntype ClientWithOrganization = Client & { organizationName: string };\n\ninterface ClientListProps {\n  organizationId?: string;\n}\n\nexport default function ClientList({ organizationId }: ClientListProps = {}) {\n  const [clients, setClients] = useState<ClientWithOrganization[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function loadData() {\n      try {\n        setLoading(true);\n        const [clientsData, organizationsData] = await Promise.all([\n          clientActions.findAllAction(organizationId),\n          organizationId ? organizationActions.getByIdAction(organizationId).then(o => o ? [o] : []) : []\n        ]);\n\n        const orgMap = new Map<string, Organization>();\n        organizationsData.forEach(org => orgMap.set(org.id, org));\n\n        // Filter by organizationId if provided\n        const filteredClients = organizationId \n          ? clientsData.filter(c => c.organizationId === organizationId)\n          : clientsData;\n\n        const enrichedClients = filteredClients.map(client => ({\n          ...client,\n          organizationName: orgMap.get(client.organizationId)?.name || 'Inconnue'\n        }));\n\n        setClients(enrichedClients);\n      } catch (error) {\n        console.error('Failed to load clients', error);\n      } finally {\n        setLoading(false);\n      }\n    }\n\n    loadData();\n  }, []);\n\n  if (loading) {\n    return (\n      <div className=\"flex justify-center items-center py-12\">\n        <div className=\"text-gray-500 animate-pulse\">Chargement des clients...</div>\n      </div>\n    );\n  }\n\n  if (clients.length === 0) {\n    return (\n      <div className=\"text-center py-12 text-gray-500\">\n        Aucun client trouvé.\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"overflow-x-auto bg-white rounded-lg shadow\">\n      <table className=\"min-w-full divide-y divide-gray-200\">\n        <thead className=\"bg-gray-50\">\n          <tr>\n            <th scope=\"col\" className=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n              Nom\n            </th>\n            <th scope=\"col\" className=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n              Email\n            </th>\n            <th scope=\"col\" className=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n              Téléphone\n            </th>\n            <th scope=\"col\" className=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n              Entreprise\n            </th>\n            <th scope=\"col\" className=\"px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider\">\n              Actions\n            </th>\n          </tr>\n        </thead>\n        <tbody className=\"bg-white divide-y divide-gray-200\">\n          {clients.map((client) => (\n            <tr key={client.id} className=\"hover:bg-gray-50 transition-colors\">\n              <td className=\"px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900\">\n                {client.name}\n              </td>\n              <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">\n                {client.email}\n              </td>\n              <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">\n                {client.phone}\n              </td>\n              <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">\n                {client.organizationName}\n              </td>\n              <td className=\"px-6 py-4 whitespace-nowrap text-right text-sm font-medium\">\n                <button className=\"text-indigo-600 hover:text-indigo-900 mr-4 opacity-50 cursor-not-allowed\" disabled>\n                  Voir\n                </button>\n                <button className=\"text-indigo-600 hover:text-indigo-900 opacity-50 cursor-not-allowed\" disabled>\n                  Modifier\n                </button>\n              </td>\n            </tr>\n          ))}\n        </tbody>\n      </table>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/soufianeelrhadi/Projets/monservice/src/components/landing/CTASection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/soufianeelrhadi/Projets/monservice/src/components/landing/FAQ.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/soufianeelrhadi/Projets/monservice/src/components/landing/Features.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/soufianeelrhadi/Projets/monservice/src/components/landing/Footer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"